# Fill these values ONLY in .hermes/.env after running setup.ps1.
TELEGRAM_BOT_TOKEN=
DEEPSEEK_API_KEY=
# Your numeric Telegram user ID; comma-separated for multiple owners.
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOW_ALL_USERS=false
# Optional proxy, only if required by your network.
# TELEGRAM_PROXY=http://127.0.0.1:8080
